# このファイルを .env.local という名前でコピーして、実際の値を入れてください。
# .env.local はコミットされません(.gitignoreで除外済み)。

# Supabaseプロジェクトの Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PubMed(NCBI E-utilities)関連。なくても動くが、設定するとレート制限が緩和される。
# APIキーは https://www.ncbi.nlm.nih.gov/account/ で取得できる(無料)
NCBI_API_KEY=
# 何かあったときNCBIから連絡が来る可能性がある連絡先メールアドレス(任意)
NCBI_CONTACT_EMAIL=
NCBI_TOOL_NAME=medical-lit-app
